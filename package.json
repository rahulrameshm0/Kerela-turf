{
  "name": "turfkerala",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "npm run build && node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check src/app.js && npm test && npm run build",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^14.5.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
